{
  "state_path": "out/llm-demo/llm-state.db",
  "policy": {
    "provider": "mock",
    "model": "mock-structured-v1",
    "enabled": false,
    "daily_tokens": 100000,
    "daily_micro_usd": 100000,
    "max_input_bytes": 8192,
